{
  "app_name": "GramService",
  "environment": "production",
  "debug": false,
  "default_timeout": 30,
  "cluster": {
    "name": "primary-node",
    "datacenter": "us-east-1"
  },
  "service_id": "cjson-gateway-gram.dev",
  "version": 2.5,
  "is_production": true,
  "cluster_node": null,
  "network": {
    "port": 8080,
    "ssl_port": 8443,
    "timeout_ms": 15000,
    "retries": 5
  },
  "resources": {
    "max_workers": 60,
    "buffer_size_kb": 64
  },
  "endpoints": [
    "https://gram.dev/api/v1",
    "https://gram.dev/api/v2",
    "https://gram.dev/metrics"
  ]
}
