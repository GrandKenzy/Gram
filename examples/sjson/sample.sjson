// =========================================================
// Archivo de Prueba SJSON (Super JSON)
// =========================================================
// 1. Definición de variables numéricas y de texto (strings)
let base_port = 8000
let host_domain = "gram.dev"
let service_name = "gateway"
let timeout_seconds = 15
let max_clients = 250
let version_major = 2
let version_minor = 5

// 2. Objeto principal extendido de otro archivo JSON
{
    // 4. Importar otro JSON usando la directiva extend
    extend: "base_config.json",

    // Variables locales al bloque del objeto
    let retry_limit = 3,

    // 2. Cálculos y expresiones con strings y números
    "service_id": service_name + "-" + host_domain, // Concatenación: "gateway-gram.dev"
    "version": version_major + (version_minor / 10), // Cálculo numérico: 2.5
    "is_production": true,
    "cluster_node": null,

    // Sub-objeto con cálculos aritméticos
    "network": {
        // 3. Comentarios con '//'
        "port": base_port + 80, // Cálculo: 8080
        "ssl_port": base_port + 443, // Cálculo: 8443
        "timeout_ms": timeout_seconds * 1000, // Cálculo: 15000
        "retries": retry_limit + 2 // Cálculo con variable local: 5
    },

    "resources": {
        "max_workers": (max_clients / 5) + 10, // Cálculo agrupado con paréntesis: 60
        "buffer_size_kb": 1024 / 16 // Cálculo: 64
    },

    "endpoints": [
        "https://" + host_domain + "/api/v1",
        "https://" + host_domain + "/api/v2",
        "https://" + host_domain + "/metrics"
    ]
}
